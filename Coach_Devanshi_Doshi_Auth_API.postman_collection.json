				{
					"name": "Signup (Mobile Required, Email Optional)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var json = pm.response.json();",
									"    if (json.data && json.data.otp) {",
									"        pm.collectionVariables.set(\"signup_otp\", json.data.otp);",
									"        console.log(\"Saved signup_otp:\", json.data.otp);",
									"    }",
									"    if (json.data && json.data.mobile) {",
									"        pm.collectionVariables.set(\"mobile\", json.data.mobile);",
									"    }",
									"    if (json.data && json.data.phone_code) {",
									"        pm.collectionVariables.set(\"phone_code\", json.data.phone_code);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Devanshi\",\n    \"last_name\": \"Doshi\",\n    \"phone_code\": \"{{phone_code}}\",\n    \"mobile\": \"{{mobile}}\",\n    \"email\": \"{{email}}\"\n}"
						},
